{
  "expo": {
    "name": "Dailer",
    "slug": "dailer",
    "scheme": "dailer",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2b1d14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.dailer.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Namoz vaqtlarini aniq hisoblash uchun joylashuvingiz kerak."
      }
    },
    "android": {
      "package": "uz.dailer.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2b1d14"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#c08552"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Namoz vaqtlarini aniq hisoblash uchun joylashuvingiz kerak."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#2b1d14"
        }
      ],
      "expo-asset",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "https://dailer-api.vercel.app",
      "googleWebClientId": "670356555721-ufek4lt8hirc6skeomm5c3ebiet0dt7b.apps.googleusercontent.com",
      "devApiUrl": "http://localhost:8010"
    }
  }
}
