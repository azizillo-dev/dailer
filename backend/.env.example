# Muhit: development | production
ENV=development

DATABASE_URL=postgresql+asyncpg://dailer:dailer@localhost:5433/dailer
REDIS_URL=redis://localhost:6379/0

# openssl rand -hex 32
JWT_SECRET=change-me
# 2FA secret'larini bazada shifrlash uchun (openssl rand -hex 32)
ENCRYPTION_KEY=change-me-too

# Frontend manzili (emaildagi havolalar va CORS uchun)
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Birinchi super admin (seed skripti yaratadi)
SUPERADMIN_EMAIL=ceonabiyev@gmail.com

# Google OAuth — Web va mobil client ID'lar vergul bilan
GOOGLE_CLIENT_IDS=

# AI provayderlar (docs/04-ai.md). Bo'sh qolganlari o'tkazib yuboriladi;
# hammasi bo'sh bo'lsa — statistikaga asoslangan shablon javob ishlaydi.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Email (lokal: mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=Dailer <no-reply@dailer.uz>
