# Muhit: development | production
ENV=development

# Supabase/Neon'ning postgres://...?sslmode=require manzili ham bo'ladi — avtomatik moslanadi
DATABASE_URL=postgresql+asyncpg://dailer:dailer@localhost:5433/dailer
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# Bo'sh qoldirilsa — Redis'siz (bitta server, xotirada)
REDIS_URL=redis://localhost:6379/0

# openssl rand -hex 32
JWT_SECRET=change-me
# 2FA secret'larini bazada shifrlash uchun (openssl rand -hex 32)
ENCRYPTION_KEY=change-me-too

# Frontend manzili (emaildagi havolalar va CORS uchun)
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# API'ning tashqi manzili (yuklangan rasmlar havolasi)
PUBLIC_URL=http://localhost:8010
# disk | db (diski vaqtinchalik hosting — rasmlar Postgres'da)
UPLOAD_STORAGE=disk

# Tashqi cron (worker o'rniga): POST /api/v1/internal/cron/tick, sarlavha X-Cron-Secret
CRON_SECRET=

# Birinchi super admin (seed skripti yaratadi)
SUPERADMIN_EMAIL=ceonabiyev@gmail.com

# Google OAuth — Web va mobil client ID'lar vergul bilan
GOOGLE_CLIENT_IDS=

# AI provayderlar (docs/04-ai.md). Bo'sh qolganlari o'tkazib yuboriladi;
# hammasi bo'sh bo'lsa — statistikaga asoslangan shablon javob ishlaydi.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Web Push: python -m scripts.gen_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email: smtp (lokal Mailpit yoki Gmail) | brevo (HTTPS API — SMTP portlari yopiq hostingda)
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_TLS=true, SMTP_USER=siz@gmail.com,
#        SMTP_PASSWORD=<16 belgili App password>, MAIL_FROM=Dailer <siz@gmail.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=Dailer <no-reply@dailer.uz>
